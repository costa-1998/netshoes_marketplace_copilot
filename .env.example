# ==========================================
# Provedor LLM: Google Cloud Vertex AI (Gemini)
# ==========================================
LLM_PROVIDER=vertexai
GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=pdia0024
GCP_LOCATION=us-central1

LLM_MODEL_ORCHESTRATOR=gemini-2.5-pro
LLM_MODEL_SPECIALISTS=gemini-2.5-flash

# ==========================================
# Banco de Dados Analítico: BigQuery
# ==========================================
DW_BACKEND=bigquery
BQ_PROJECT_ID=pdia0024
BQ_DATASET=netshoes_kam_analytics
BQ_VIEW_CHILD_SKU=vw_seller_performance_child_sku
BQ_LOCATION=US

# ==========================================
# Memória de Sessão & Ambiente
# ==========================================
MEMORY_BACKEND=memory  # Opções futuras: memory | sqlite | redis
SESSION_TTL_SECONDS=86400

# ==========================================
# Backend local determinístico (DW_BACKEND=mock)
# Caminhos das fixtures CSV. Os defaults já apontam para tests/fixtures;
# as fixtures estão no .gitignore e não são versionadas.
# ==========================================
MOCK_DATA_PATH=tests/fixtures/seller_sku_sales.csv
MOCK_SELLER_MASTER_PATH=tests/fixtures/seller_master.csv